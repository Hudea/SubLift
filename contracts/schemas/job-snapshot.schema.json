{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sublift.local/contracts/job-snapshot.schema.json",
  "title": "JobSnapshot",
  "description": "Authoritative job state exposed by Server and Worker. entries are the final editable result; incremental push_entry events are preview only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["job_id", "status", "config", "entries"],
  "properties": {
    "job_id": { "type": "string", "minLength": 1 },
    "status": {
      "enum": [
        "queued",
        "preparing",
        "extracting",
        "finalizing",
        "completed",
        "failed",
        "cancelled",
        "interrupted"
      ]
    },
    "config": { "type": "object" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start_ms", "end_ms", "text", "confidence"],
        "properties": {
          "start_ms": { "type": "integer", "minimum": 0 },
          "end_ms": { "type": "integer", "minimum": 0 },
          "text": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
