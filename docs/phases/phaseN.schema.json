{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sublift.local/schemas/phase.schema.json",
  "title": "SubLift Harness Phase Detail Schema",
  "description": "Phase 级任务追踪。legacy 分支仅冻结既有 Phase 1–6 的 feat-* 历史证据；canonical 分支约束 Harness 迁移后的新任务。",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "phase", "features"],
  "properties": {
    "project": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "description": "Legacy Phase 的目标、边界或归档说明。"
    },
    "plan_file": {
      "type": "string",
      "minLength": 1,
      "description": "Legacy Phase 的设计源头相对路径。"
    },
    "features": {
      "type": "array"
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "title": "Frozen legacy phase detail",
          "properties": {
            "phase": {
              "enum": [
                "Phase 1 - CLI MVP",
                "Phase 2 - macOS GUI",
                "phase3-opt-perf",
                "phase4-roi-data-path",
                "phase4.1-post-roi-throughput",
                "phase4.2-ocr-performance-attribution",
                "phase5-paddle-ocr",
                "phase6-native-cpp-core"
              ]
            },
            "features": {
              "items": {
                "$ref": "#/$defs/legacy_feature"
              }
            }
          }
        },
        {
          "title": "Canonical Harness phase detail",
          "properties": {
            "phase": {
              "type": "string",
              "pattern": "^Phase (?:[7-9]|[1-9][0-9]+)(?:\\.[0-9]+)?(?:\\s|：|:|$)"
            },
            "features": {
              "items": {
                "$ref": "#/$defs/canonical_feature"
              }
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "canonical_status": {
      "type": "string",
      "enum": ["not-started", "in-progress", "blocked", "done"]
    },
    "legacy_status": {
      "type": "string",
      "enum": ["not-started", "in-progress", "blocked", "done", "archived", "completed"]
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "legacy_feature_id": {
      "type": "string",
      "pattern": "^feat-[0-9]{3,5}$"
    },
    "canonical_feature_id": {
      "type": "string",
      "pattern": "^[0-9]{5}$",
      "description": "五位稳定历史标识。新建时前两位为所属 Phase、第三位为子阶段、后两位为 Feature 序号；已完成 Feature 被吸收到同领域 Phase 时保留原 ID，不因容器变化重编号。"
    },
    "legacy_subtask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/legacy_status"
        },
        "evidence": {
          "type": "string"
        }
      }
    },
    "legacy_feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "module", "dependencies", "status", "evidence"],
      "properties": {
        "id": {
          "$ref": "#/$defs/legacy_feature_id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "module": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "subtasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/legacy_subtask"
          }
        },
        "status": {
          "$ref": "#/$defs/legacy_status"
        },
        "evidence": {
          "type": "string"
        }
      }
    },
    "canonical_subtask": {
      "type": "object",
      "description": "Subtask ID 继承所属 Feature 的稳定五位 ID；吸收式 Phase 迁移时同样不重编号。",
      "additionalProperties": false,
      "required": ["id", "name", "description", "dependencies", "status"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9]{5}\\.[0-9]{2}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]{5}\\.[0-9]{2}$"
          },
          "uniqueItems": true
        },
        "status": {
          "$ref": "#/$defs/canonical_status"
        }
      }
    },
    "canonical_feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "module",
        "dependencies",
        "acceptance_criteria",
        "status",
        "evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/canonical_feature_id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "module": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/canonical_feature_id"
          },
          "uniqueItems": true
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "non_goals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "architecture_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "subtasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/canonical_subtask"
          }
        },
        "status": {
          "$ref": "#/$defs/canonical_status"
        },
        "evidence": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "done"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "evidence": {
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
