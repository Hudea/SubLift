  "pure_validate_crop": [
    {
      "name": "valid_crop",
      "crop": {
        "x": 10,
        "y": 10,
        "width": 160,
        "height": 120
      },
      "source_width": 320,
      "source_height": 240,
      "expected_ok": true,
      "expected_error_contains": null
    },
    {
      "name": "edge_touch",
      "crop": {
        "x": 0,
        "y": 0,
        "width": 320,
        "height": 240
      },
      "source_width": 320,
      "source_height": 240,
      "expected_ok": true,
      "expected_error_contains": null
    },
    {
      "name": "negative_x",
      "crop": {
        "x": -1,
        "y": 10,
        "width": 160,
        "height": 120
      },
      "source_width": 320,
      "source_height": 240,
      "expected_ok": false,
      "expected_error_contains": "output_crop 的 x/y 不能为负"
    },
    {
      "name": "negative_y",
      "crop": {
        "x": 10,
        "y": -1,
        "width": 160,
        "height": 120
      },
      "source_width": 320,
      "source_height": 240,
      "expected_ok": false,
      "expected_error_contains": "output_crop 的 x/y 不能为负"
    },
    {
      "name": "zero_width",
      "crop": {
        "x": 0,
        "y": 0,
        "width": 0,
        "height": 120
      },
      "source_width": 320,
      "source_height": 240,
      "expected_ok": false,
      "expected_error_contains": "output_crop 的 width/height 必须为正"
    },
    {
      "name": "zero_height",
      "crop": {
        "x": 0,
        "y": 0,
        "width": 160,
        "height": 0
      },
      "source_width": 320,
      "source_height": 240,
      "expected_ok": false,
      "expected_error_contains": "output_crop 的 width/height 必须为正"
    },
    {
      "name": "out_of_bounds",
      "crop": {
        "x": 200,
        "y": 100,
        "width": 160,
        "height": 180
      },
      "source_width": 320,
      "source_height": 240,
      "expected_ok": false,
      "expected_error_contains": "output_crop 越界"
    },
    {
      "name": "overflow_y",
      "crop": {
        "x": 0,
        "y": 200,
        "width": 160,
        "height": 50
      },
      "source_width": 320,
      "source_height": 240,
      "expected_ok": false,
      "expected_error_contains": "output_crop 越界"
    }
  ],
  "pure_build_vf": [
    {
      "name": "full_frame_1fps",
      "fps": 1.0,
      "crop": null,
