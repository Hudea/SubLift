# 复制为 .env 后按本机修改。.env 不入库。
# 用法：SUBLIFT_MEDIA_DIR 必填；其余可省略。

# 宿主上存放视频的目录，挂载为容器 /media（唯一媒体授权根）
SUBLIFT_MEDIA_DIR=/srv/sublift/media

# 宿主监听端口，映射到容器 8080
SUBLIFT_HTTP_PORT=8080

# 可选。设置后 /api/* 需要 Authorization: Bearer <token>。
# 当前 Web UI 不会发送该头，开启后浏览器工作台会 401；仅建议给 curl/脚本使用。
# 未设置时不要把端口暴露到公网。
# SUBLIFT_ACCESS_TOKEN=
