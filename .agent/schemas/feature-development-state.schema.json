{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Feature Development State v6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "feature_id",
    "phase_id",
    "phase_detail_file",
    "phase_state_ref",
    "implementation_baseline_ref",
    "feature_plan",
    "authorization",
    "current_stage",
    "resume_stage",
    "test_mode",
    "change_scope",
    "decisions",
    "capability_runs",
    "testing_results",
    "review_results",
    "verification_results",
    "iteration",
    "commit_preparation",
    "commit",
    "blocker",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": 6
    },
    "feature_id": {
      "type": "string",
      "minLength": 1
    },
    "phase_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "phase_detail_file": {
      "type": [
        "string",
        "null"
      ]
    },
    "phase_state_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "implementation_baseline_ref": {
      "type": "string",
      "minLength": 1
    },
    "feature_plan": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "status",
            "digest"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                "draft",
                "needs-decision",
                "ready"
              ]
            },
            "digest": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution"
      ],
      "properties": {
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authority",
            "scope",
            "evidence"
          ],
          "properties": {
            "authority": {
              "enum": [
                "user",
                "phase-development"
              ]
            },
            "scope": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "current_stage": {
      "enum": [
        "planning",
        "testing-prepare",
        "implementing",
        "testing-verify",
        "reviewing",
        "verifying",
        "committing",
        "completed",
        "blocked"
      ]
    },
    "resume_stage": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "planning",
        "testing-prepare",
        "implementing",
        "testing-verify",
        "reviewing",
        "verifying",
        "committing",
        null
      ]
    },
    "test_mode": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "required",
        "characterization",
        "posthoc",
        "verification-only",
        null
      ]
    },
    "change_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "level",
          "summary",
          "decision",
          "authority",
          "evidence"
        ],
        "properties": {
          "level": {
            "enum": [
              "D1",
              "D2",
              "D3"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "type": "string",
            "minLength": 1
          },
          "authority": {
            "enum": [
              "main-agent",
              "user",
              "phase-development"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "capability_runs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "capability-run.schema.json"
      }
    },
    "testing_results": {
      "type": "array",
      "items": {
        "$ref": "../skills/test/assets/test-result.schema.json"
      }
    },
    "review_results": {
      "type": "array",
      "items": {
        "$ref": "../skills/review/assets/review-result.schema.json"
      }
    },
    "verification_results": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "../skills/verify/assets/verification-result.schema.json"
          },
          {
            "properties": {
              "verification_level": {
                "const": "feature"
              }
            }
          }
        ]
      }
    },
    "iteration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation_cycles",
        "consecutive_same_blocker",
        "no_progress_cycles"
      ],
      "properties": {
        "implementation_cycles": {
          "type": "integer",
          "minimum": 0
        },
        "consecutive_same_blocker": {
          "type": "integer",
          "minimum": 0
        },
        "no_progress_cycles": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "commit_preparation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commit_message_run_ref",
            "scope_validated",
            "atomicity_validated",
            "verification_result_ref",
            "proposed_subject",
            "proposed_body"
          ],
          "properties": {
            "commit_message_run_ref": {
              "type": "string",
              "minLength": 1
            },
            "scope_validated": {
              "type": "boolean"
            },
            "atomicity_validated": {
              "type": "boolean"
            },
            "verification_result_ref": {
              "type": "string",
              "minLength": 1
            },
            "proposed_subject": {
              "type": "string",
              "minLength": 1
            },
            "proposed_body": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "commit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "sha",
        "message",
        "receipt_ref",
        "history"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "committed",
            "failed"
          ]
        },
        "sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-fA-F]{7,64}$"
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "receipt_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sha",
              "message",
              "kind"
            ],
            "properties": {
              "sha": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{7,64}$"
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "feature",
                  "repair"
                ]
              }
            }
          }
        }
      }
    },
    "blocker": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "summary",
            "next_action"
          ],
          "properties": {
            "kind": {
              "enum": [
                "input",
                "decision",
                "planning",
                "testing",
                "review",
                "verification",
                "environment",
                "commit",
                "no-progress"
              ]
            },
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "next_action": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "current_stage": {
            "enum": [
              "testing-prepare",
              "implementing",
              "testing-verify",
              "reviewing",
              "verifying",
              "committing",
              "completed"
            ]
          }
        },
        "required": [
          "current_stage"
        ]
      },
      "then": {
        "properties": {
          "feature_plan": {
            "type": "object",
            "properties": {
              "status": {
                "const": "ready"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "current_stage": {
            "const": "blocked"
          },
          "resume_stage": {
            "enum": [
              "testing-prepare",
              "implementing",
              "testing-verify",
              "reviewing",
              "verifying",
              "committing"
            ]
          }
        },
        "required": [
          "current_stage",
          "resume_stage"
        ]
      },
      "then": {
        "properties": {
          "feature_plan": {
            "type": "object",
            "properties": {
              "status": {
                "const": "ready"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "current_stage": {
            "const": "blocked"
          }
        },
        "required": [
          "current_stage"
        ]
      },
      "then": {
        "properties": {
          "blocker": {
            "type": "object"
          },
          "resume_stage": {
            "type": "string"
          }
        }
      },
      "else": {
        "properties": {
          "blocker": {
            "type": "null"
          },
          "resume_stage": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "current_stage": {
            "const": "completed"
          }
        },
        "required": [
          "current_stage"
        ]
      },
      "then": {
        "properties": {
          "capability_runs": {
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "capability": {
                      "const": "plan"
                    },
                    "output": {
                      "properties": {
                        "status": {
                          "const": "completed"
                        }
                      }
                    }
                  },
                  "required": [
                    "capability",
                    "output"
                  ]
                }
              },
              {
                "contains": {
                  "properties": {
                    "capability": {
                      "const": "feature-development"
                    },
                    "stage": {
                      "const": "feature"
                    },
                    "output": {
                      "properties": {
                        "status": {
                          "const": "completed"
                        }
                      }
                    }
                  },
                  "required": [
                    "capability",
                    "stage",
                    "output"
                  ]
                }
              },
              {
                "contains": {
                  "properties": {
                    "capability": {
                      "const": "verify"
                    },
                    "stage": {
                      "const": "feature"
                    },
                    "output": {
                      "properties": {
                        "status": {
                          "const": "completed"
                        }
                      }
                    }
                  },
                  "required": [
                    "capability",
                    "stage",
                    "output"
                  ]
                }
              },
              {
                "contains": {
                  "properties": {
                    "capability": {
                      "const": "commit"
                    },
                    "output": {
                      "properties": {
                        "status": {
                          "const": "completed"
                        }
                      }
                    }
                  },
                  "required": [
                    "capability",
                    "output"
                  ]
                }
              },
              {
                "contains": {
                  "properties": {
                    "capability": {
                      "const": "commit-message"
                    },
                    "output": {
                      "properties": {
                        "status": {
                          "const": "completed"
                        }
                      }
                    }
                  },
                  "required": [
                    "capability",
                    "output"
                  ]
                }
              }
            ]
          },
          "commit_preparation": {
            "type": "object",
            "properties": {
              "scope_validated": {
                "const": true
              },
              "atomicity_validated": {
                "const": true
              }
            }
          },
          "commit": {
            "properties": {
              "status": {
                "const": "committed"
              },
              "sha": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{7,64}$"
              },
              "history": {
                "minItems": 1
              }
            }
          },
          "verification_results": {
            "contains": {
              "properties": {
                "verification_level": {
                  "const": "feature"
                },
                "status": {
                  "const": "VERIFICATION_PASSED"
                }
              },
              "required": [
                "verification_level",
                "status"
              ]
            },
            "minContains": 1
          }
        }
      }
    }
  ]
}
