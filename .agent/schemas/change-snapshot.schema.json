{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Change Snapshot Fingerprint v1",
  "$comment": "Canonical manifest: normalize targets to unique repository-relative paths, sort paths by byte order, then emit UTF-8 lines as <state>\\t<path>\\t<content_sha256-or->\\n. Present-file digests are SHA-256 of raw bytes; deleted files use '-'. The top-level value is SHA-256 of the manifest raw bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "algorithm", "value", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "algorithm": {"const": "sha256-manifest-v1"},
    "value": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "state", "content_sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*[\\t\\r\\n]).+$"},
          "state": {"enum": ["present", "deleted"]},
          "content_sha256": {
            "oneOf": [
              {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              {"type": "null"}
            ]
          }
        },
        "allOf": [
          {
            "if": {"properties": {"state": {"const": "deleted"}}, "required": ["state"]},
            "then": {"properties": {"content_sha256": {"type": "null"}}},
            "else": {"properties": {"content_sha256": {"type": "string"}}}
          }
        ]
      }
    }
  }
}
