{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase Development State v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase_id",
    "detail_file",
    "baseline_ref",
    "final_ref",
    "authorization",
    "status",
    "current_feature_id",
    "feature_runs",
    "deferred_blockers",
    "capability_runs",
    "verification_results",
    "iteration",
    "blocker",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "phase_id": {
      "type": "string",
      "minLength": 1
    },
    "detail_file": {
      "type": "string",
      "minLength": 1
    },
    "baseline_ref": {
      "type": "string",
      "minLength": 1
    },
    "final_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution"
      ],
      "properties": {
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authority",
            "scope",
            "evidence"
          ],
          "properties": {
            "authority": {
              "const": "user"
            },
            "scope": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "status": {
      "enum": [
        "running",
        "verifying",
        "completed",
        "blocked"
      ]
    },
    "current_feature_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "feature_runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "feature_id",
          "dependencies",
          "status",
          "state_ref",
          "commit_shas",
          "last_outcome"
        ],
        "properties": {
          "feature_id": {
            "type": "string",
            "minLength": 1
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "pending",
              "active",
              "blocked",
              "completed"
            ]
          },
          "state_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "commit_shas": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{7,64}$"
            },
            "uniqueItems": true
          },
          "last_outcome": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "deferred_blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "feature_id",
          "kind",
          "summary",
          "next_action"
        ],
        "properties": {
          "feature_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "input",
              "decision",
              "planning",
              "testing",
              "review",
              "verification",
              "environment",
              "commit",
              "no-progress"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "next_action": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "capability_runs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "capability-run.schema.json"
      }
    },
    "verification_results": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "../skills/verify/assets/verification-result.schema.json"
          },
          {
            "properties": {
              "verification_level": {
                "const": "phase"
              }
            }
          }
        ]
      }
    },
    "iteration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase_verification_cycles",
        "consecutive_same_blocker",
        "no_progress_cycles"
      ],
      "properties": {
        "phase_verification_cycles": {
          "type": "integer",
          "minimum": 0
        },
        "consecutive_same_blocker": {
          "type": "integer",
          "minimum": 0
        },
        "no_progress_cycles": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "blocker": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "summary",
            "next_action"
          ],
          "properties": {
            "kind": {
              "enum": [
                "input",
                "decision",
                "dependency",
                "feature",
                "verification",
                "environment",
                "commit",
                "no-progress"
              ]
            },
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "next_action": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "blocker": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "blocker": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "verifying",
              "completed"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "current_feature_id": {
            "type": "null"
          },
          "feature_runs": {
            "items": {
              "properties": {
                "status": {
                  "const": "completed"
                },
                "commit_shas": {
                  "minItems": 1
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "final_ref": {
            "type": "string",
            "minLength": 1
          },
          "capability_runs": {
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "capability": {
                      "const": "phase-development"
                    },
                    "stage": {
                      "const": "phase"
                    },
                    "output": {
                      "properties": {
                        "status": {
                          "const": "completed"
                        }
                      }
                    }
                  },
                  "required": [
                    "capability",
                    "stage",
                    "output"
                  ]
                }
              },
              {
                "contains": {
                  "properties": {
                    "capability": {
                      "const": "verify"
                    },
                    "stage": {
                      "const": "phase"
                    },
                    "output": {
                      "properties": {
                        "status": {
                          "const": "completed"
                        }
                      }
                    }
                  },
                  "required": [
                    "capability",
                    "stage",
                    "output"
                  ]
                }
              }
            ]
          },
          "verification_results": {
            "contains": {
              "properties": {
                "verification_level": {
                  "const": "phase"
                },
                "status": {
                  "const": "VERIFICATION_PASSED"
                }
              },
              "required": [
                "verification_level",
                "status"
              ]
            },
            "minContains": 1
          }
        }
      }
    }
  ]
}
